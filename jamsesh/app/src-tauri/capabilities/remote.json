{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-drag",
  "description": "The session's pages (served by the host through this Mac) may drag their window by its header.",
  "windows": ["client", "bigscreen", "bigscreen-*", "remote"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": ["core:window:allow-start-dragging"]
}
