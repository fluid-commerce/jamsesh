  "productName": "JamSesh",
  "version": "0.1.0",
  "identifier": "com.fluidcommerce.jamsesh",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
