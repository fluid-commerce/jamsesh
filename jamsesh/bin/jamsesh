#!/usr/bin/env bash
# jamsesh: run the host, or connect this laptop to someone else's host.
#   jamsesh host [--no-open]     start the session on this machine and open the big screen
#   jamsesh join <host[:port]>   connect this laptop (Claude Code, Codex, your JamSesh window)
#   jamsesh off | on             pause or resume this laptop's hooks
#   jamsesh status               what's running
#   jamsesh key                  set the Vercel AI Gateway key for this machine
#   jamsesh new                  start the next session fresh (the last one is archived, not deleted)
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
PORT="${JAMSESH_PORT:-4747}"
ENV_FILE="$HOME/.jamsesh/client.env"

open_big_screen() {
  local url="${1:-http://127.0.0.1:$PORT/host}"
  local chrome="/Applications/Google Chrome.app"
  if [ -d "$chrome" ]; then
    open -na "$chrome" --args --app="$url" --start-fullscreen --user-data-dir="$HOME/.jamsesh/chrome-host" \
      --autoplay-policy=no-user-gesture-required --no-first-run >/dev/null 2>&1
  else
    open "$url"
  fi
}

case "${1:-help}" in
  host)
    shift
    cd "$DIR"
    if curl -fsS --max-time 1 "http://127.0.0.1:$PORT/healthz" >/dev/null 2>&1; then
      echo "JamSesh is already running on port $PORT."
      [ "${1:-}" = "--no-open" ] && exit 0
      # A fresh one-time host link, so the browser is the host's window (approvals, the pairing code).
      # The secret file is the running hub's own (mode 600); curl reads the header from it, so the
      # secret never shows in a process list.
      secret="${JAMSESH_DATA:-${JAMSESH_HOME:-$HOME/.jamsesh}/host}/host-link.secret"
      link=""
      if [ -r "$secret" ]; then
        link="$( (curl -fsS --max-time 3 -X POST -H "@$secret" "http://127.0.0.1:$PORT/api/host-link" 2>/dev/null || true) | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')"
      fi
      if [ -n "$link" ]; then
        open_big_screen "$link"
      else
        echo "Couldn't get a host link from it (was it started by the Mac app?). This browser can watch but not approve or show the code." >&2
        open_big_screen
      fi
      exit 0
    fi
    if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
      echo "Port $PORT is used by another app ($(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN | awk 'NR==2{print $1}')). Start JamSesh on another port:" >&2
      echo "  JAMSESH_PORT=4848 jamsesh host" >&2
      exit 1
    fi
    # The hub opens the big screen itself, with its one-time host link (SPEC 14).
    if [ "${1:-}" = "--no-open" ]; then shift; exec bun run hub/src/index.ts "$@"; fi
    exec bun run hub/src/index.ts --open "$@"
    ;;
  join)
    target="${2:?Usage: jamsesh join <host[:port]>}"
    case "$target" in http*) ;; *) target="http://$target" ;; esac
    case "$target" in *:[0-9]*) ;; *) target="$target:4747" ;; esac
    curl -fsSL "$target/join.sh" | bash
    ;;
  off | on)
    [ -f "$ENV_FILE" ] || { echo "This laptop hasn't joined a session."; exit 1; }
    v=$([ "$1" = on ] && echo 1 || echo 0)
    sed -i '' "s/^JAMSESH_ACTIVE=.*/JAMSESH_ACTIVE=$v/" "$ENV_FILE"
    echo "JamSesh hooks are $1."
    ;;
  status)
    if curl -fsS --max-time 1 "http://127.0.0.1:$PORT/healthz" >/dev/null 2>&1; then
      echo "Host: running at http://127.0.0.1:$PORT/host"
    else
      echo "Host: not running on this machine"
    fi
    if [ -f "$ENV_FILE" ]; then
      (. "$ENV_FILE"; echo "This laptop: joined $JAMSESH_HUB as $JAMSESH_NAME (hooks $([ "$JAMSESH_ACTIVE" = 1 ] && echo on || echo off))")
    else
      echo "This laptop: not joined to a session"
    fi
    ;;
  key)
    exec "$DIR/scripts/set-gateway-key.sh"
    ;;
  new)
    if curl -fsS --max-time 1 "http://127.0.0.1:$PORT/healthz" >/dev/null 2>&1; then
      echo "Stop the running host first (Ctrl+C in its terminal)." >&2
      exit 1
    fi
    data="${JAMSESH_DATA:-$HOME/.jamsesh/host}"
    if [ -d "$data" ]; then
      archive="$data-$(date +%Y-%m-%d-%H%M)"
      mv "$data" "$archive"
      echo "Archived the last session to $archive. The next 'jamsesh host' starts fresh."
    else
      echo "No session to archive."
    fi
    ;;
  *)
    sed -n '2,8p' "$SELF" | sed 's/^# \{0,1\}//'
    ;;
esac
