+/**
+ * An event posted to a process carries no window, and AppKit drops a mouse or scroll event without one (it arrives
+ * with windowNumber 0 and never reaches a view, whether the app is in front or not). The event needs the window's
+ * number (field 51) and the point inside that window, top-left origin. There's no public setter for that point: it's
+ * the "window location" entry of the event's record (tag 0xc039, two big-endian floats), so it's written there. If the
+ * record ever looks different, the event goes out as before rather than with a wrong point.
+ */
+func post(_ e: CGEvent?, _ pid: pid_t, _ wid: CGWindowID) {
+  guard let e else { return }
+  lock.lock()
+  let origin = current?.id == wid ? current?.bounds.origin : nil
+  lock.unlock()
+  if let field = CGEventField(rawValue: 51) { e.setIntegerValueField(field, value: Int64(wid)) }
+  guard let origin, let cf = e.data else { return e.postToPid(pid) }
+  var d = Data(referencing: cf as NSData)
+  let head = d.prefix(64)
+  guard let r = head.range(of: Data([0x00, 0x02, 0xc0, 0x39])), r.upperBound + 8 <= d.count else { return e.postToPid(pid) }
+  let at = e.location
+  var lx = Float(at.x - origin.x).bitPattern.bigEndian
+  var ly = Float(at.y - origin.y).bitPattern.bigEndian
+  d.replaceSubrange(r.upperBound..<r.upperBound + 4, with: Data(bytes: &lx, count: 4))
+  d.replaceSubrange(r.upperBound + 4..<r.upperBound + 8, with: Data(bytes: &ly, count: 4))
+  (CGEvent(withDataAllocator: nil, data: d as CFData) ?? e).postToPid(pid)
 }
